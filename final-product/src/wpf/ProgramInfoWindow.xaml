<!-- 프로그램 설명·출처·전송 미리보기 창이다. 상태와 허용 명령은 code-behind의 SetEnabled,
     선택 연결과 비동기 응답 수락은 Reconcile/RefreshAsync/ExecuteAsync에서 결정한다. -->
<Window x:Class="PcMonitor.ProgramInfoWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="이 프로그램 알아보기" Width="850" Height="830" MinWidth="460" MinHeight="440"
        WindowStartupLocation="CenterOwner" Background="#F1F4F1" Foreground="#172D2C"
        FontFamily="pack://application:,,,/Assets/#Noto Sans KR" FontSize="14"
        TextOptions.TextRenderingMode="Grayscale" UseLayoutRounding="True" SnapsToDevicePixels="True">
    <Window.Resources>
        <SolidColorBrush x:Key="InfoInk" Color="#172D2C"/>
        <SolidColorBrush x:Key="InfoMuted" Color="#506562"/>
        <Style TargetType="TextBlock"><Setter Property="VerticalAlignment" Value="Center"/></Style>
        <Style x:Key="StateBadgeStyle" TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
            <Setter Property="Foreground" Value="#147865"/>
            <Style.Triggers><DataTrigger Binding="{Binding Tag, RelativeSource={RelativeSource Self}}" Value="True"><Setter Property="Foreground" Value="#955014"/></DataTrigger></Style.Triggers>
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8"/><Setter Property="Margin" Value="0,0,8,7"/>
            <Setter Property="MinHeight" Value="36"/><Setter Property="Foreground" Value="{StaticResource InfoInk}"/>
            <Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#C6D5CE"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="Button">
                <Border Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                    <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" RecognizesAccessKey="True"/>
                </Border>
            </ControlTemplate></Setter.Value></Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#E7F3ED"/><Setter Property="BorderBrush" Value="#147865"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#D2EADF"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter Property="BorderBrush" Value="#147865"/><Setter Property="BorderThickness" Value="2"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#74847D"/><Setter Property="Background" Value="#EDF1EE"/><Setter Property="BorderBrush" Value="#D8E1DB"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style x:Key="PrimaryButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#147865"/><Setter Property="Foreground" Value="White"/><Setter Property="BorderBrush" Value="#147865"/>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter Property="Background" Value="#0E6655"/></Trigger>
                <Trigger Property="IsPressed" Value="True"><Setter Property="Background" Value="#0A5748"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter Property="Background" Value="#DFE8E1"/><Setter Property="Foreground" Value="#74847D"/><Setter Property="BorderBrush" Value="#D8E1DB"/></Trigger>
            </Style.Triggers>
        </Style>
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{StaticResource InfoInk}"/><Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C6D5CE"/><Setter Property="Margin" Value="0,7,10,7"/>
            <Setter Property="Padding" Value="11,9"/><Setter Property="VerticalContentAlignment" Value="Center"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="RadioButton">
                <Grid>
                    <Border x:Name="RadioSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7" Padding="{TemplateBinding Padding}">
                        <DockPanel><Grid Width="18" Height="18" Margin="0,0,9,0" DockPanel.Dock="Left">
                            <Ellipse x:Name="RadioRing" Fill="White" Stroke="#6D8D81" StrokeThickness="1.5"/>
                            <Ellipse x:Name="RadioMark" Width="10" Height="10" Fill="#147865" Visibility="Collapsed"/>
                        </Grid><ContentPresenter VerticalAlignment="Center" RecognizesAccessKey="True"/></DockPanel>
                    </Border>
                    <Border x:Name="RadioFocus" BorderBrush="#147865" BorderThickness="2" CornerRadius="9" Margin="-3" Visibility="Collapsed" IsHitTestVisible="False"/>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsChecked" Value="True"><Setter TargetName="RadioMark" Property="Visibility" Value="Visible"/><Setter TargetName="RadioRing" Property="Stroke" Value="#147865"/><Setter TargetName="RadioSurface" Property="Background" Value="#E7F3ED"/><Setter TargetName="RadioSurface" Property="BorderBrush" Value="#147865"/></Trigger>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="RadioSurface" Property="BorderBrush" Value="#147865"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="RadioFocus" Property="Visibility" Value="Visible"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#74847D"/><Setter TargetName="RadioSurface" Property="Background" Value="#EDF1EE"/><Setter TargetName="RadioSurface" Property="BorderBrush" Value="#D8E1DB"/><Setter TargetName="RadioRing" Property="Stroke" Value="#A1B0A7"/><Setter TargetName="RadioMark" Property="Fill" Value="#A1B0A7"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Foreground" Value="{StaticResource InfoInk}"/><Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C6D5CE"/><Setter Property="BorderThickness" Value="1"/>
            <Setter Property="Padding" Value="11,9"/><Setter Property="CaretBrush" Value="#147865"/>
            <Setter Property="SelectionBrush" Value="#BCE3D2"/><Setter Property="SelectionTextBrush" Value="#172D2C"/><Setter Property="SelectionOpacity" Value="0.35"/>
            <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="InputBorder" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="7">
                    <ScrollViewer x:Name="PART_ContentHost" Margin="{TemplateBinding Padding}"/>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="InputBorder" Property="BorderBrush" Value="#147865"/><Setter TargetName="InputBorder" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#74847D"/><Setter TargetName="InputBorder" Property="Background" Value="#EDF1EE"/><Setter TargetName="InputBorder" Property="BorderBrush" Value="#D8E1DB"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBoxItem">
            <Setter Property="Foreground" Value="{StaticResource InfoInk}"/><Setter Property="Background" Value="White"/>
            <Setter Property="Padding" Value="11,9"/><Setter Property="MinHeight" Value="36"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
                <Border x:Name="Choice" Background="{TemplateBinding Background}" Padding="{TemplateBinding Padding}" BorderThickness="1" BorderBrush="Transparent" CornerRadius="4"><ContentPresenter/></Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Choice" Property="Background" Value="#E7F3ED"/></Trigger>
                    <Trigger Property="IsSelected" Value="True"><Setter TargetName="Choice" Property="Background" Value="#CFE9DC"/><Setter Property="Foreground" Value="#0D6655"/><Setter Property="FontWeight" Value="SemiBold"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="Choice" Property="BorderBrush" Value="#147865"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#74847D"/><Setter TargetName="Choice" Property="Background" Value="#EDF1EE"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Foreground" Value="{StaticResource InfoInk}"/><Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#C6D5CE"/><Setter Property="MinHeight" Value="38"/>
            <Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
            <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <Border x:Name="ComboSurface" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="1" CornerRadius="7"/>
                    <ContentPresenter Margin="11,8,34,8" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" IsHitTestVisible="False" VerticalAlignment="Center"/>
                    <ToggleButton Focusable="False" ClickMode="Press" IsChecked="{Binding IsDropDownOpen, Mode=TwoWay, RelativeSource={RelativeSource TemplatedParent}}">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton"><Border Background="Transparent"><Path HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,13,0" Data="M 0 0 L 5 5 L 10 0" Stroke="#506562" StrokeThickness="1.6"/></Border></ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <Popup x:Name="PART_Popup" Placement="Bottom" IsOpen="{TemplateBinding IsDropDownOpen}" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border Background="White" BorderBrush="#9FB8AA" BorderThickness="1" CornerRadius="7" Padding="4" MinWidth="{Binding ActualWidth, RelativeSource={RelativeSource TemplatedParent}}" Margin="0,3,0,0">
                            <ScrollViewer MaxHeight="260" CanContentScroll="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#147865"/></Trigger>
                    <Trigger Property="IsKeyboardFocusWithin" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#147865"/><Setter TargetName="ComboSurface" Property="BorderThickness" Value="2"/></Trigger>
                    <Trigger Property="IsDropDownOpen" Value="True"><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#147865"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Foreground" Value="#74847D"/><Setter TargetName="ComboSurface" Property="Background" Value="#EDF1EE"/><Setter TargetName="ComboSurface" Property="BorderBrush" Value="#D8E1DB"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value></Setter>
        </Style>
        <Style x:Key="StatusCardStyle" TargetType="Border">
            <Setter Property="Background" Value="#E7F3ED"/><Setter Property="BorderBrush" Value="#B7D5C5"/>
            <Setter Property="BorderThickness" Value="1"/><Setter Property="CornerRadius" Value="10"/>
            <Style.Triggers>
                <Trigger Property="Tag" Value="Busy"><Setter Property="Background" Value="#EAF2F7"/><Setter Property="BorderBrush" Value="#C0D2DF"/></Trigger>
                <Trigger Property="Tag" Value="Invalid"><Setter Property="Background" Value="#FFF2DD"/><Setter Property="BorderBrush" Value="#E6C897"/></Trigger>
                <Trigger Property="Tag" Value="Pending"><Setter Property="Background" Value="White"/><Setter Property="BorderBrush" Value="#D5DFD9"/></Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>
    <Grid Margin="22,18,22,14">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <StackPanel Margin="0,0,0,13">
            <TextBlock x:Name="TargetLabel" FontSize="21" FontWeight="Bold" TextWrapping="Wrap"/>
            <TextBlock Text="선택한 프로그램의 역할·신원·시작 근거를 읽기 전용으로 확인합니다." Foreground="{StaticResource InfoMuted}" TextWrapping="Wrap" Margin="0,6,0,0"/>
        </StackPanel>
        <Border x:Name="StatusCard" Grid.Row="1" Style="{StaticResource StatusCardStyle}" Padding="14,12" Margin="0,0,0,14">
            <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                <StackPanel Margin="0,0,12,0"><TextBlock x:Name="StateBadge" Text="확인 전" Style="{StaticResource StateBadgeStyle}" FontSize="12" FontWeight="Bold"/><TextBlock x:Name="StatusHeading" Text="프로그램 정보를 확인하세요" FontWeight="SemiBold" FontSize="15" Margin="0,3,0,5" TextWrapping="Wrap"/><TextBlock x:Name="StatusText" Foreground="{StaticResource InfoMuted}" FontSize="13" TextWrapping="Wrap"/></StackPanel>
                <Button Grid.Column="1" x:Name="RefreshButton" Content="새로고침" Click="RefreshClicked" Margin="0" VerticalAlignment="Top" ToolTip="현재 선택의 신원과 로컬 근거를 다시 확인"/>
            </Grid>
        </Border>
        <ScrollViewer Grid.Row="2" x:Name="DialogScroll" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
            <StackPanel>
                <TextBlock Text="어떻게 쓰고 싶으세요?" FontWeight="SemiBold"/>
                <TextBlock Text="선택 사항 · 자동 시작 설정을 바꾸지 않습니다" Foreground="{StaticResource InfoMuted}" FontSize="12" Margin="0,3,0,0"/>
                <WrapPanel>
                    <RadioButton x:Name="AutoPurpose" GroupName="Purpose" Content="로그인 뒤 자동 준비" Checked="PurposeChanged"/>
                    <RadioButton x:Name="ManualPurpose" GroupName="Purpose" Content="쓸 때 직접 실행" Checked="PurposeChanged"/>
                </WrapPanel>
                <WrapPanel Margin="0,1,0,7"><Button Content="목적 선택 지우기" Click="ClearPurpose" IsEnabled="{Binding IsEnabled, ElementName=AutoPurpose, Mode=OneWay}"/><Button x:Name="DetailsButton" Content="+ 자세한 근거" Click="ToggleDetails"/></WrapPanel>
                <TextBox x:Name="BodyText" IsReadOnly="True" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="15" FontSize="14" AcceptsReturn="True" MinHeight="190" MaxHeight="360" AutomationProperties.Name="프로그램 설명과 근거"/>
                <!-- 조회·번역 버튼은 미리보기부터 열고 승인 버튼이 ExecuteAsync로 이어진다.
                     출처 선택과 명시적 문서 열기는 별도 흐름이며 native provider가 URL을 확인한다. -->
                <TextBlock Text="공식 자료" FontWeight="SemiBold" Margin="0,16,0,7"/>
                <WrapPanel>
                    <Button x:Name="ResearchButton" Content="공식 자료로 알아보기" Click="PreviewResearch"/>
                    <Button x:Name="TranslateButton" Content="공개 원문 한국어로 읽기" Click="PreviewTranslation"/>
                    <Button x:Name="ApproveButton" Content="이 내용으로 조회" Visibility="Collapsed" Click="ApprovePreview" Style="{StaticResource PrimaryButton}"/>
                    <Button x:Name="CancelPreviewButton" Content="미리보기 닫기" Visibility="Collapsed" Click="CancelPreview"/>
                </WrapPanel>
                <ComboBox x:Name="Sources" SelectionChanged="SourceChanged" Margin="0,3,0,8" AutomationProperties.Name="확인할 공식 자료"/>
                <Grid><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                    <TextBox x:Name="SourceUrl" IsReadOnly="True" Foreground="#0D6655" Background="#F7F9F7" HorizontalScrollBarVisibility="Auto" AutomationProperties.Name="선택한 공식 문서 주소"/>
                    <Button Grid.Column="1" x:Name="CopyButton" Content="주소 복사" Click="CopyUrl" Margin="8,0,0,0"/>
                </Grid>
                <Button x:Name="OpenButton" Content="공식 문서 열기" Click="OpenSource" HorizontalAlignment="Left" Margin="0,10,0,10"/>
            </StackPanel>
        </ScrollViewer>
        <Grid Grid.Row="3" Margin="0,12,0,0"><Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions><TextBlock Text="외부 조회는 보낼 내용 확인과 동의 후에 시작합니다." Foreground="{StaticResource InfoMuted}" FontSize="11" TextWrapping="Wrap" VerticalAlignment="Center" Margin="0,0,12,0"/><Button Grid.Column="1" Content="닫기" Click="CloseClicked" Margin="0" MinWidth="70"/></Grid>
    </Grid>
</Window>
