<!-- 같은 ShareRow를 미리보기와 고정 목록에 쓴다. Present가 둘 중 하나를 보여 주며
     행 선택은 GroupChosen 이벤트로 ViewSmallGroups의 현재 그룹 확인에 전달한다. -->
<UserControl x:Class="PcMonitor.SmallGroupFlyout"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    Focusable="False" KeyboardNavigation.TabNavigation="Cycle"
    TextOptions.TextRenderingMode="Grayscale">
    <UserControl.Resources>
        <DataTemplate x:Key="ShareRow">
            <Grid Margin="8,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="9"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <Ellipse Width="9" Height="9" Fill="{Binding Color}"/>
                <TextBlock Grid.Column="1" Text="{Binding Name}" Margin="7,0" FontSize="13"
                    Foreground="#182E2D" VerticalAlignment="Center" TextTrimming="CharacterEllipsis"/>
                <TextBlock Grid.Column="2" Text="{Binding Share}" Foreground="#182E2D" FontSize="13"
                    FontWeight="Bold" VerticalAlignment="Center" TextAlignment="Right"/>
            </Grid>
        </DataTemplate>
    </UserControl.Resources>
    <Border x:Name="Surface" Background="White" BorderBrush="#AEBFB6" BorderThickness="1"
            CornerRadius="9" Padding="4" SnapsToDevicePixels="True">
        <Border.Effect><DropShadowEffect Color="#162D29" ShadowDepth="3" BlurRadius="9" Opacity="0.2"/></Border.Effect>
        <Grid>
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
            <DockPanel x:Name="Heading" Margin="6,0,0,4">
                <Button x:Name="CloseButton" DockPanel.Dock="Right" Content="×" Width="25" Height="25" MinHeight="0"
                        Padding="0" FontSize="16" Background="#F1F5F2" AutomationProperties.Name="작은 그룹 목록 닫기"
                        Click="CloseClick" VerticalAlignment="Top"/>
                <StackPanel>
                    <TextBlock x:Name="MetricTitle" FontWeight="Bold" FontSize="14" Foreground="#182E2D"/>
                    <TextBlock x:Name="SampleTime" FontSize="11" Foreground="#526A67"/>
                </StackPanel>
            </DockPanel>
            <ItemsControl x:Name="PreviewRows" Grid.Row="1" ItemTemplate="{StaticResource ShareRow}" Focusable="False">
                <ItemsControl.ItemContainerStyle><Style TargetType="ContentPresenter"><Setter Property="Height" Value="25"/></Style></ItemsControl.ItemContainerStyle>
            </ItemsControl>
            <ListBox x:Name="Choices" Grid.Row="1" BorderThickness="0" Padding="0" Background="White"
                AutomationProperties.Name="선택할 작은 그룹" ItemTemplate="{StaticResource ShareRow}"
                ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.VerticalScrollBarVisibility="Auto"
                ScrollViewer.CanContentScroll="True" VirtualizingPanel.IsVirtualizing="True">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Height" Value="30"/><Setter Property="Padding" Value="0"/>
                        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
                            <Border x:Name="Row" BorderThickness="1" BorderBrush="Transparent" Background="White" CornerRadius="5">
                                <ContentPresenter VerticalAlignment="Stretch" HorizontalAlignment="Stretch"/>
                            </Border>
                            <ControlTemplate.Triggers>
                                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Row" Property="Background" Value="#F1F7F4"/></Trigger>
                                <Trigger Property="IsSelected" Value="True"><Setter TargetName="Row" Property="Background" Value="#EEF6F1"/>
                                    <Setter TargetName="Row" Property="BorderBrush" Value="#147865"/></Trigger>
                            </ControlTemplate.Triggers>
                        </ControlTemplate></Setter.Value></Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
            </ListBox>
            <Button x:Name="ShowAllButton" Grid.Row="2" Background="#EDF5F0" Foreground="#147865"
                    Margin="0,3,0,0" Padding="5,0" Height="27" MinHeight="0" Click="ShowAllClick"/>
            <Border x:Name="KeyBar" Grid.Row="2" BorderBrush="#D5DFD9" BorderThickness="0,1,0,0" Margin="4,5,4,0" Padding="0,5">
                <TextBlock Text="↑ ↓ 이동   Enter 선택   Esc 닫기" Foreground="#526A67" FontSize="11" TextAlignment="Center"/>
            </Border>
        </Grid>
    </Border>
</UserControl>
