# 로컬 작업 기록과 편집기 설정
/.local-private/
/WORK_LOG.md
/AGENTS.md
.vs/
.vscode/

# 빌드 중간 파일과 임시 배포 압축 파일
*.exe
*.dll
*.lib
*.obj
*.exp
*.pdb
*.ilk
*.zip

# 개인 이력 DB, 로그, 자격증명
*.db
*.db-*
*.sqlite
*.sqlite-*
*.sqlite3
*.sqlite3-*
*.log
.env
.env.*
*.pem
*.key
*.pfx
*.p12

# 빌드와 회귀 실행이 만드는 중간 파일과 시험 결과
.build/
.test-results/

# 저장소에 동봉하는 Windows x64 실행 파일과 DLL
!/bin/win-x64/*.exe
!/bin/win-x64/**/*.dll
